# deck.secrets — credentials baked into the card. NEVER COMMIT THIS.
#
# Copy to deck.secrets and fill in. The image and the finished card both
# contain these in recoverable form: Raspberry Pi OS has no disk encryption
# and the card pulls out with a fingernail.

DECK_USER_PASSWORD = change-me

# One or more WiFi networks, highest priority first.
DECK_WIFI_SSID_1 = HomeNetwork
DECK_WIFI_PSK_1 = your-wifi-password

# DECK_WIFI_SSID_2 = Hotspot
# DECK_WIFI_PSK_2 = another-password

# Optional: your public key, for SSH without a password.
DECK_SSH_PUBKEY =
