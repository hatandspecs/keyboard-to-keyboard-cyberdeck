# deck.conf — how to build the SD card for the cyberdeck.
#
# This file describes the *machine*: hostname, account, WiFi country, display
# and keyboard. What the station calls itself and how it operates lives in
# cyberdeck.conf, which is installed alongside it. Credentials live in
# deck.secrets, which is gitignored.
#
# Same form as the iGate project's pi.conf: KEY = value, '#' comments.

# --- The card ---
DECK_IMAGE_VARIANT = armhf        # armhf | arm64. 512 MB on a 3A+ wants armhf
DECK_IMAGE_PATH =                 # a downloaded .img.xz to reuse; blank = fetch
DECK_HOSTNAME = cyberdeck
DECK_USER = deck
DECK_INSTALL_DIR = cyberdeck      # under /opt

# --- Locale ---
DECK_WIFI_COUNTRY = US
# UTC, so journal timestamps match the panel. The terminal's own clock is Zulu
# regardless — it uses gmtime and cannot be configured off it — so a local
# timezone here only makes the journal disagree with the screen.
DECK_TIMEZONE = UTC

# --- Real-time clock ---
# The 3A+ has no clock of its own: from power-on the system time is whatever
# fake-hwclock saved at the last shutdown, until NTP corrects it. Every
# timestamp the deck shows is a system clock read — the status line and the
# stamp on every transcript line — so a field session with no WiFi is stamped
# wrong from end to end, and those stamps are what a log would be written from.
#
# Setting this makes a flashed card come up with the clock working: the build
# writes dtparam=i2c_arm=on and dtoverlay=i2c-rtc,<chip> into config.txt, and
# first boot removes fake-hwclock and writes the system time into the chip once
# NTP is good. Blank = no RTC, fake-hwclock left in place.
#
# The value is the chip, as the i2c-rtc overlay names it: ds3231, pcf8523,
# ds1307, pcf8563. Tested: ds3231, on an Adafruit PiRTC (product 4282), which
# plugs onto header pins 1-10 and needs no wiring.
#
# Buy the board rather than using a common ZS-042 module. Those carry a
# diode-and-resistor charging circuit for a rechargeable LIR2032; a
# non-rechargeable CR2032 fitted there is trickle-charged, and can leak or vent
# inside a deck that lives in a bag. The Adafruit board has no charging
# circuit, so its CR1220 is a plain primary cell and correct as supplied.
DECK_RTC = ds3231
DECK_KEYBOARD = us
DECK_LOCALE = C.UTF-8

# --- Display ---
# The 5" DSI panel. The overlay name varies by panel and by kernel; check the
# vendor's instructions before building. See design_doc.md §3.3 and §16.
DECK_PANEL_OVERLAY = vc4-kms-dsi-7inch
DECK_CONSOLE_FONT = Uni3-TerminusBold24x12   # 66x20 on 800x480
DECK_HIDE_BOOT_MESSAGES = yes                # quiet boot, no cursor, no getty

# --- Bluetooth keyboard ---
# Pairing has no interface on a headless appliance, so the keyboard is named
# here and paired by the first-boot script. The MAC is what bluetoothctl
# reports; DECK_BT_KEYBOARD_NAME is only used in messages.
#
# Put the keyboard in pairing mode before the deck's first boot. If it is not
# found, first boot retries on a timer rather than giving up, and the deck can
# still be reached over SSH.
DECK_BT_KEYBOARD = AA:BB:CC:DD:EE:FF
DECK_BT_KEYBOARD_NAME = Logitech K380
DECK_BT_PAIR_TIMEOUT = 120        # seconds to look for it on each attempt

# --- Radio ---
# The FTX-1 presents CAT, PTT and a codec over one USB-C cable. These are the
# values proven in the iGate project on the same radio and board.
DECK_RIG_MODEL = 1035             # hamlib; 1035 = FT-991, works for the FTX-1
DECK_CAT_DEVICE = /dev/ttyUSB0
DECK_CAT_BAUD = 38400
DECK_PTT_DEVICE = /dev/ttyACM0
DECK_AUDIO_DEVICE = plughw:1,0

# --- Behavior ---
DECK_AUTOSTART = yes              # start the terminal on tty1 at boot
DECK_SSH = yes                    # keep SSH, for updates and recovery
DECK_RUN_TMPFS_SIZE = 32M
