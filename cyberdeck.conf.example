# cyberdeck.conf — this station's settings.
#
# Copy to cyberdeck.conf and edit. Same form as the iGate project's files:
# KEY = value, '#' starts a comment, blank lines ignored. An unrecognized key
# is refused rather than ignored, because a typo that is silently absorbed
# becomes a setting that mysteriously does nothing.

# --- Station ---
CALLSIGN = KD3CCO
NAME = Don
QTH = State College, PA
LOCATOR = FN10cs
RIG = FTX-1

# --- Operating defaults ---
DEFAULT_MODE = BPSK31

# --- WiFi ---
# The WiFi screen (F1 7 w) can switch the radio off, and nmcli remembers that
# across a reboot. This switches it back on at every start, which is what
# makes the toggle safe to offer: with WiFi off and the Bluetooth keyboard
# flat there is no SSH, no keyboard, and the radio in the only USB port, so a
# power cycle is the only recovery — and it only recovers if WiFi returns.
#
# The toggle is therefore for this session, not the next one. Setting this to
# no removes the recovery path and there is no other way back in.
WIFI_ON_START = yes
# The audio carrier is parked here and left alone; the radio's own waterfall
# and VFO bring a signal to this offset. See design_doc.md §8.
DEFAULT_CARRIER = 1500

# --- Display ---
# matrix (green) | deckard (amber) | hal (red) | tron (cyan-blue)
COLOR = matrix
# Console font, which sets the character grid on an 800x480 panel:
#   8x16 -> 100x30 (too small to read on 5")   10x20 -> 80x24
#   12x24 -> 66x20 (proposed default)          16x32 -> 50x15
FONT = 12x24
TIMESTAMPS = yes
SCROLLBACK = 2000

# --- fldigi ---
FLDIGI_URL = http://127.0.0.1:7362/
POLL_MS = 200

# --- Safety ---
# Seconds before an over is aborted. The radio's own time-out timer is the
# real backstop; this is the software one. 0 disables it.
TX_TIMEOUT = 180
